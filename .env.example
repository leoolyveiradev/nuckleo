# =============================================================================
# NUCKLEO — Variáveis de ambiente globais
# Copie este arquivo para .env e preencha os valores.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Backend Node.js (Express + MongoDB) — Railway em produção
# -----------------------------------------------------------------------------
PORT=3001
MONGO_URI=mongodb://localhost:27017/nuckleo

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# JWT / sessão (gerar segredo forte em produção)
JWT_SECRET=altere-este-segredo-em-producao

# -----------------------------------------------------------------------------
# URLs consumidas pelo frontend (frontend/app.js)
# -----------------------------------------------------------------------------
API_NODE_URL=http://localhost:3001/api
API_PYTHON_URL=http://localhost:8000/api

# Produção Railway — descomente após o deploy:
# API_NODE_URL=https://nuckleo-production.up.railway.app/api

# -----------------------------------------------------------------------------
# Backend Python (FastAPI + MySQL) — servidor local de IA
# -----------------------------------------------------------------------------
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nuckleo
MYSQL_PASSWORD=
MYSQL_DB=nuckleo_ai

# -----------------------------------------------------------------------------
# App / marca
# -----------------------------------------------------------------------------
APP_NAME=Nuckleo
APP_URL=http://localhost:5500
CONTACT_EMAIL=privacidade@horbyonstudios.com
